{
  "name": "otlp-http",
  "target": {
    "transport": "otlp-http",
    "endpoint": "http://collector.example:4318",
    "options": { "path": "/v1/logs", "encoding": "json" }
  },
  "types": {
    "json-app": {
      "batch_size": 100,
      "anchor": { "mode": "knee", "knee_eps": 5000 },
      "scenario": "sweep"
    }
  },
  "emit_timeline": true,
  "thresholds": { "send_failures": "rate<0.001", "send_duration": "p(99)<250" }
}
