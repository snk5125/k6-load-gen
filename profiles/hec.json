{
  "name": "hec",
  "target": {
    "transport": "hec",
    "endpoint": "https://splunk.example:8088",
    "options": {
      "path": "/services/collector/event",
      "token_env": "HEC_TOKEN",
      "index": "main",
      "sourcetype": "k6:load",
      "gzip": false
    }
  },
  "types": {
    "json-app": {
      "batch_size": 100,
      "anchor": { "mode": "knee", "knee_eps": 5000 },
      "scenario": "sweep"
    }
  },
  "emit_timeline": true,
  "thresholds": { "send_failures": "rate<0.001", "send_duration": "p(99)<250" }
}
