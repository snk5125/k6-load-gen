{
  "name": "otlp-grpc",
  "target": {
    "transport": "otlp-grpc",
    "endpoint": "collector.example:4317",
    "options": { "plaintext": true, "timeout": "10s" }
  },
  "types": {
    "json-app": {
      "batch_size": 100,
      "anchor": { "mode": "knee", "knee_eps": 5000 },
      "scenario": "sweep"
    }
  },
  "emit_timeline": true,
  "thresholds": { "send_failures": "rate<0.001", "send_duration": "p(99)<250" }
}
