{
  "name": "syslog",
  "target": {
    "transport": "syslog",
    "endpoint": "syslog.example:601",
    "options": { "rfc": 5424, "framing": "octet-counted", "tls": false, "app_name": "k6-load-gen" }
  },
  "payload": {
    "template": "json-app",
    "batch_size": 100,
    "fields": {
      "host": { "cardinality": 500, "distribution": "zipf" },
      "service": { "cardinality": 20 },
      "level": { "values": ["INFO", "WARN", "ERROR"], "weights": [0.8, 0.15, 0.05] },
      "trace_id": { "cardinality": "unbounded" },
      "message": { "cardinality": 50, "pad_to": 512 }
    }
  },
  "anchor": { "mode": "knee", "knee_eps": 5000 },
  "scenario": "sweep",
  "emit_timeline": true,
  "thresholds": { "send_failures": "rate<0.001", "send_duration": "p(99)<1000" }
}
