{
  "name": "syslog",
  "target": {
    "transport": "syslog",
    "endpoint": "syslog.example:601",
    "options": { "rfc": 5424, "framing": "octet-counted", "tls": false, "app_name": "k6-load-gen" }
  },
  "types": {
    "json-app": {
      "batch_size": 100,
      "anchor": { "mode": "knee", "knee_eps": 5000 },
      "scenario": "sweep"
    }
  },
  "emit_timeline": true,
  "thresholds": { "send_failures": "rate<0.001", "send_duration": "p(99)<1000" }
}
