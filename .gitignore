# macOS
.DS_Store
._*

# Node / dev tooling (vitest, tsc — never shipped in the image)
node_modules/
*.tsbuildinfo

# Bundled CLI output — built inside the image (stage 2), never committed
dist/

# Run artifacts — results live in S3 or a mounted path, not the repo
results/
summary.json
summary-*.json
timeline*.jsonl
raw*.json*
*.log

# Secrets / env — never commit credentials or live endpoints
.env
*.pem
*.key
credentials*

# Subagent-driven development workspace (ledger, briefs, review packages)
.superpowers/

# Local editor/agent config
.claude/

# Local worktrees for plan execution (scratch, never part of the image)
.worktrees/

# Stale local-only docs. These predate the multi-log-type system: one hard-codes
# a cloud region in its run examples, the other describes the eager-connect gRPC
# lifecycle the transports no longer use. Kept on disk, never published.
docs/user-guide.md
docs/architecture-overview.md
